<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/recallHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="再收起资料，完整顺一遍"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:background="@drawable/bg_badge"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.55"
            android:textColor="@color/ink" />

        <!-- 折叠：原问题与我刚才的作答 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Xyw.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/foldHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▾  原问题与我刚才的作答"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink2"
                    android:paddingBottom="4dp" />

                <LinearLayout
                    android:id="@+id/foldBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        style="@style/Xyw.Text.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="首次作答"
                        android:textSize="11.5sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/firstAttemptText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="14.5sp"
                        android:lineSpacingMultiplier="1.6"
                        android:textColor="@color/ink2" />

                    <TextView
                        android:id="@+id/stuckLabel"
                        style="@style/Xyw.Text.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当时的卡点"
                        android:textSize="11.5sp"
                        android:letterSpacing="0.08"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/amber"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/stuckText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="14.5sp"
                        android:lineSpacingMultiplier="1.6"
                        android:textColor="@color/ink"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Xyw.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/final_note_label"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etFinalNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:gravity="top|start"
            android:background="@drawable/bg_input"
            android:padding="14dp"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:inputType="textMultiLine|textCapSentences"
            android:hint="@string/final_note_hint"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink3"
            android:importantForAutofill="no"
            android:maxLength="1000" />

        <Space
            android:layout_width="1dp"
            android:layout_height="24dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
