<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/btnBack"
                style="@style/Xyw.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="设置"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:gravity="center" />

            <Space android:layout_width="64dp" android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            style="@style/Xyw.Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="全部数据存在本机，不上传、不需要账号。" />

        <TextView
            style="@style/Xyw.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="单轮节奏"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/stageSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Xyw.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示与反馈"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/toggleRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Xyw.Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数据"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/storageInfo"
            style="@style/Xyw.Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="SQLite · 0 题存档" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportJson"
            style="@style/Xyw.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="导出全部记录（JSON）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportMd"
            style="@style/Xyw.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="导出为 Markdown（可贴进 Notion）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/Xyw.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="从备份文件恢复 / 合并" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWipe"
            style="@style/Xyw.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="清空全部数据"
            android:textColor="@color/red" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:textSize="12sp"
            android:textColor="@color/ink3"
            android:text="学一问 1.0.0 · 原生 Android · 本地优先" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
