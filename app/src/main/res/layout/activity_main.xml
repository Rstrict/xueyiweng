<?xml version="1.0" encoding="utf-8"?>
<!--
  根布局用 FrameLayout：
  - 主内容（container + tabBar）在下层
  - fullscreen 全屏层在上层，直接覆盖，z 序天然正确
  不用 CoordinatorLayout —— 它的 Behavior 会干扰同层 View 的触摸分发。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/mainLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg">

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg"
            android:elevation="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/tabToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconToday"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tab_today"
                    android:contentDescription="@string/tab_today" />

                <TextView
                    android:id="@+id/textToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_today"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink2"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabArchive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp"
                android:paddingBottom="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconArchive"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tab_archive"
                    android:contentDescription="@string/tab_archive" />

                <TextView
                    android:id="@+id/textArchive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_archive"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink2"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 全屏沉浸层：学习中 / 复习。
         显式声明 accessibilityPaneTitle + importantForAccessibility，
         否则无障碍服务（含 uiautomator）无法遍历这一层的子控件。 -->
    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:accessibilityPaneTitle="@string/app_name"
        android:importantForAccessibility="yes"
        android:visibility="gone" />
</FrameLayout>
