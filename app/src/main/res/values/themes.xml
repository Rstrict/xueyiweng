<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.XueYiWen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="android:textColorHint">@color/ink3</item>
        <item name="materialAlertDialogTheme">@style/Theme.XueYiWen.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.XueYiWen.BottomSheet</item>
    </style>

    <style name="Theme.XueYiWen.Night" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
        <item name="android:textColorHint">@color/ink3</item>
    </style>

    <style name="Theme.XueYiWen.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="Theme.XueYiWen.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Xyw.BottomSheetStyle</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Xyw.BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_sheet</item>
        <item name="behavior_peekHeight">auto</item>
    </style>

    <!-- 主行动按钮 -->
    <style name="Xyw.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/accentInk</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 次级描边按钮 -->
    <style name="Xyw.Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/ink2</item>
        <item name="strokeColor">@color/lineStrong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- 文字按钮 -->
    <style name="Xyw.Button.Quiet" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink2</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Xyw" />

    <style name="Xyw.Text" />

    <style name="Xyw.Text.PageTitle">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Xyw.Text.SectionLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink2</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="Xyw.Text.FieldLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink2</item>
    </style>

    <style name="Xyw.Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink2</item>
    </style>

    <style name="Xyw.Text.Hint">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/ink3</item>
    </style>

    <!-- 掌握度三档按钮：白底描边，靠左侧色点区分 -->
    <style name="Xyw.MasteryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="backgroundTint">@color/card</item>
        <item name="strokeColor">@color/lineStrong</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Xyw.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
